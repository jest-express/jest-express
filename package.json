{
  "name": "jest-express-monorepo",
  "private": true,
  "description": "Mock Express 5 app, Router, req, res and next for unit tests: express-mock-core (core), jest-express and vitest-express",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:types": "turbo run test:types",
    "typecheck": "turbo run typecheck",
    "lint:pkg": "turbo run lint:pkg",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jest-express/jest-express.git"
  },
  "author": "James W. Lane <james.w.lane@mac.com>",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2"
}

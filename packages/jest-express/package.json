{
  "name": "jest-express",
  "version": "1.12.0",
  "description": "Mock Express 5 app, Router, req, res and next for Jest. Configures jest.fn on import.",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "jest",
    "test:types": "vitest run --typecheck.only",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jest-express/jest-express.git",
    "directory": "packages/jest-express"
  },
  "keywords": [
    "express",
    "express5",
    "mock",
    "testing",
    "unit-test",
    "jest",
    "typescript"
  ],
  "author": "James W. Lane <james.w.lane@mac.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jest-express/jest-express/issues"
  },
  "homepage": "https://github.com/jest-express/jest-express/tree/master/packages/jest-express#readme",
  "devDependencies": {
    "jest": "30.2.0",
    "jest-mock": "30.2.0"
  },
  "dependencies": {
    "express-mock-core": "workspace:^"
  },
  "peerDependencies": {
    "@types/express": "^5",
    "jest": ">=29",
    "jest-mock": ">=29"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
